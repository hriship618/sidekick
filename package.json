    "zod": "^4"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "45.2.3",
    "esbuild": "^0.28",
    "typescript": "^6"
  }
}
