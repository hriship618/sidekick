{
  "name": "sidekick-desktop",
  "productName": "Sidekick",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "main": "dist/main.cjs",
  "engines": {
    "node": ">=24.15"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node scripts/build.mjs && electron .",
